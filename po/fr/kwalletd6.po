#: ksecretd/knewwalletdialog.cpp:51
#, fuzzy, kde-format
#| msgid ""
#| "<qt>KDE has requested to create a new wallet named '<b>%1</b>'. This is "
#| "used to store sensitive data in a secure fashion. Please choose the new "
