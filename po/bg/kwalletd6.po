#: ksecretd/knewwalletdialogintro.ui:17 ksecretd/kwalletwizardpageintro.ui:17
#, kde-format
msgid "The KDE Wallet System"
msgstr "Система \"Портфейл\" за KDE"

#. i18n: ectx: property (text), widget (QLabel, labelIntro)
#: ksecretd/knewwalletdialogintro.ui:30
#, no-c-format, kde-format
msgid ""
"<html><head/><body><p>The application '<span style=\" font-weight:600;\">%1</"
"span>' has requested to open the KDE wallet. This is used to securely store "
"sensitive data, such as account passwords. Choose the type of the new wallet "
"below or click Cancel to deny the application's request.</p></body></html>"
msgstr ""
"<html><head/><body><p>Приложението '<span style=\" font-weight:600;\">%1</"
"span>' поиска да отвори KDE портфейла. Това се използва за сигурно "
"съхранение на чувствителни данни, като пароли за профили. Избор на тип нов "
"портфейл от списъка по-долу или натискане на „Отказ“ за отказ от заявката на "
"приложението.</p></body></html>"

