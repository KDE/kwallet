#: main.cpp:22 main.cpp:24
#, kde-format
msgid "KWallet query interface"
msgstr "KWallet クエリインターフェイス"

#: main.cpp:26
#, kde-format
msgid "(c) 2015, The KDE Developers"
msgstr "(c) 2015, The KDE Developers"

#: main.cpp:31
#, kde-format
msgid "verbose output"
msgstr "詳細な情報を出力"

#: main.cpp:32
#, kde-format
msgid "list password entries"
msgstr "パスワードエントリを一覧表示"

#: main.cpp:33
#, kde-format
msgid "reads the secrets from the given <entry>"
msgstr "指定された <entry> からシークレットを読み込む"

#: main.cpp:33 main.cpp:34
#, kde-format
msgid "Entry"
msgstr "エントリ"

#: main.cpp:34
#, kde-format
msgid ""
"write secrets to the given <entry>. The values are read from the standard "
"input. IMPORTANT: previous wallet entry value will be overwritten!"
msgstr ""
"指定された <entry> にシークレットを書き込む。値は標準入力から読み込まれます。"
"【重要】以前のウォレットエントリの値は上書きされます。"

#: main.cpp:35
#, kde-format
msgid "specify the folder in the wallet <folder>"
msgstr "ウォレット内のフォルダ <folder> を指定"

#: main.cpp:35
#, kde-format
msgid "Folder"
msgstr "フォルダ"

#: main.cpp:39
#, kde-format
msgid "The wallet to query"
msgstr "クエリ対象のウォレット"

#: main.cpp:49
#, kde-format
msgid "Missing argument"
msgstr "引数が指定されていません"

#: main.cpp:53
#, kde-format
msgid "Too many arguments given"
msgstr "指定された引数が多すぎます"

#: main.cpp:58
#, kde-format
msgid "Only one mode (list, read or write) can be set. Aborting"
msgstr "設定できるモード (list, read, write) は 1 つのみです。処理を中止します"

#: main.cpp:62
#, kde-format
msgid "Please specify the mode (list or read)."
msgstr "モード (list または read) を指定してください。"

#: querydriver.cpp:46
#, kde-format
msgid "Wallet %1 not found"
msgstr "ウォレット %1 が見つかりません"

#: querydriver.cpp:70
#, kde-format
msgid "Failed to open wallet %1. Aborting"
msgstr "ウォレット %1 を開けませんでした。処理を中止します"

#: querydriver.cpp:104 querydriver.cpp:121
#, kde-format
msgid "The folder %1 does not exist!"
msgstr "フォルダ %1 は存在しません。"

#: querydriver.cpp:130
#, kde-format
msgid "Failed to read entry %1 value from the %2 wallet."
msgstr "ウォレット %2 からエントリ %1 の値を読み込めませんでした。"

#: querydriver.cpp:141 querydriver.cpp:156
#, kde-format
msgid "Failed to read entry %1 value from the %2 wallet"
msgstr "ウォレット %2 からエントリ %1 の値を読み込めませんでした"

#: querydriver.cpp:189 querydriver.cpp:205
#, kde-format
msgid "Failed to write entry %1 value to %2 wallet"
msgstr "ウォレット %2 にエントリ %1 の値を書き込めませんでした"
